NODE_ENV=development
PORT=3000

# Generate each value independently with a cryptographically secure password tool.
# Production startup rejects short/default secrets.
CLIO_JWT_SECRET=replace-with-at-least-32-random-characters
CLIO_DEVICE_ENROLLMENT_CODE=replace-with-a-private-pairing-code

# Comma-separated origins used by the web build. Native apps do not send Origin.
CLIO_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Provider credentials stay on the backend and are never embedded in the app.
# Groq is the default when GROQ_API_KEY is present. Set CLIO_*_PROVIDER explicitly
# when both providers are configured. Supported values: groq, openai.
GROQ_API_KEY=
OPENAI_API_KEY=
CLIO_AI_PROVIDER=groq
CLIO_VOICE_PROVIDER=groq
CLIO_VISION_PROVIDER=groq
CLIO_AI_MODEL=openai/gpt-oss-20b
CLIO_VISION_MODEL=qwen/qwen3.6-27b
CLIO_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
CLIO_TTS_MODEL=canopylabs/orpheus-v1-english
CLIO_TTS_VOICE=hannah
